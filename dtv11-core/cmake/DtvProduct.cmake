function(dtv_add_product)
    cmake_parse_arguments(PRODUCT "" "NAME;COMMAND;VERSION;DEFAULT_MODEL" "MODELS;SOURCES" ${ARGN})
    if(NOT PRODUCT_NAME OR NOT PRODUCT_COMMAND OR NOT PRODUCT_VERSION OR NOT PRODUCT_MODELS)
        message(FATAL_ERROR "dtv_add_product requires NAME, COMMAND, VERSION, and MODELS")
    endif()

    set(model_sources)
    set(model_declarations)
    set(model_values)
    set(unique_models ${PRODUCT_MODELS})
    list(REMOVE_DUPLICATES unique_models)
    list(LENGTH PRODUCT_MODELS model_count)
    list(LENGTH unique_models unique_model_count)
    if(NOT model_count EQUAL unique_model_count)
        message(FATAL_ERROR "MODELS must not contain duplicate identifiers")
    endif()
    foreach(model IN LISTS PRODUCT_MODELS)
        if(NOT model MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            message(FATAL_ERROR "Invalid model identifier: ${model}")
        endif()
        set(model_source "${CMAKE_CURRENT_SOURCE_DIR}/lib/${model}.cpp")
        if(NOT EXISTS "${model_source}")
            message(FATAL_ERROR "Model source does not exist: ${model_source}")
        endif()
        foreach(product_source IN LISTS PRODUCT_SOURCES)
            get_filename_component(product_source_abs "${product_source}" ABSOLUTE
                                   BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
            if("${product_source_abs}" STREQUAL "${model_source}")
                message(FATAL_ERROR "MODELS sources must not also appear in SOURCES: ${model_source}")
            endif()
        endforeach()
        list(APPEND model_sources "${model_source}")
        string(APPEND model_declarations "extern const ModelEntry ${model}_model;\n")
        string(APPEND model_values "        &${model}_model,\n")
    endforeach()
    set(PRODUCT_MODELS_COUNT "${model_count}")
    string(SHA256 product_hash "${PRODUCT_NAME}")
    string(SUBSTRING "${product_hash}" 0 20 PRODUCT_SYMBOL_SUFFIX)
    set(PRODUCT_ENTRY_SYMBOL "dtv_product_entry_${PRODUCT_SYMBOL_SUFFIX}")

    set(registry_source "${CMAKE_CURRENT_BINARY_DIR}/${PRODUCT_NAME}_registry.cpp")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DtvProductRegistry.cpp.in"
                   "${registry_source}" @ONLY)

    add_library(${PRODUCT_NAME} STATIC ${model_sources} ${PRODUCT_SOURCES} ${registry_source})
    target_link_libraries(${PRODUCT_NAME} PUBLIC dtv::userland)
    target_compile_features(${PRODUCT_NAME} PUBLIC cxx_std_20)
    set_target_properties(${PRODUCT_NAME} PROPERTIES CXX_EXTENSIONS OFF)
    set_property(GLOBAL PROPERTY "DTV_PRODUCT_SYMBOL_${PRODUCT_NAME}" "${PRODUCT_ENTRY_SYMBOL}")

    set(cli_source "${CMAKE_CURRENT_BINARY_DIR}/${PRODUCT_COMMAND}_main.cpp")
    if(NOT DEFINED PRODUCT_DEFAULT_MODEL)
        set(PRODUCT_DEFAULT_MODEL "")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cli/main.cpp.in"
                   "${cli_source}" @ONLY)
    add_executable(${PRODUCT_COMMAND} "${cli_source}")
    dtv_add_product_aggregate(${PRODUCT_COMMAND}_registry PRODUCTS ${PRODUCT_NAME})
    target_link_libraries(${PRODUCT_COMMAND} PRIVATE ${PRODUCT_NAME} ${PRODUCT_COMMAND}_registry dtv::userland)
    set_target_properties(${PRODUCT_COMMAND} PROPERTIES CXX_EXTENSIONS OFF)
endfunction()

function(dtv_add_product_aggregate TARGET)
    cmake_parse_arguments(AGGREGATE "" "" "PRODUCTS" ${ARGN})
    if(NOT AGGREGATE_PRODUCTS)
        message(FATAL_ERROR "dtv_add_product_aggregate requires PRODUCTS")
    endif()
    set(declarations)
    set(entries)
    foreach(product IN LISTS AGGREGATE_PRODUCTS)
        get_property(symbol GLOBAL PROPERTY "DTV_PRODUCT_SYMBOL_${product}")
        if(NOT symbol)
            message(FATAL_ERROR "Unknown product target in aggregate: ${product}")
        endif()
        string(APPEND declarations "extern const ProductEntry ${symbol};\n")
        string(APPEND entries "        &${symbol},\n")
    endforeach()
    set(aggregate_count 0)
    list(LENGTH AGGREGATE_PRODUCTS aggregate_count)
    set(aggregate_source "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_aggregate.cpp")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DtvProductAggregate.cpp.in"
                   "${aggregate_source}" @ONLY)
    add_library(${TARGET} STATIC "${aggregate_source}")
    target_link_libraries(${TARGET} PUBLIC dtv::userland ${AGGREGATE_PRODUCTS})
    target_compile_features(${TARGET} PUBLIC cxx_std_20)
    set_target_properties(${TARGET} PROPERTIES CXX_EXTENSIONS OFF)
endfunction()
